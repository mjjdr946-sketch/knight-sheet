# Copier en .env (chmod 600) sur le VPS. Aucun secret ici : app sans backend,
# sans donnée serveur (tout reste en localStorage client).
KNIGHT_PORT=8011
KNIGHT_BIND_IP=127.0.0.1
KNIGHT_DOMAIN=knight-nunnun.duckdns.org
# host = Caddy système du VPS (défaut, modèle Biblio en production)
# bundled = conteneur Caddy de cette stack (ports 8080/8443 par défaut)
KNIGHT_TLS_MODE=host
KNIGHT_CADDY_HTTP=8080
KNIGHT_CADDY_HTTPS=8443
# page de contrôle du deploiement (la racine fait un redirect vers /personnage/combat)
KNIGHT_CHECK_PATH=/personnage/combat
# Renseigné par deploy/deploy.sh (traçabilité image)
KNIGHT_GIT_SHA=dev
# Accès protégé (prompt v6 §5) : mot de passe unique partagé, requis AU BUILD.
# OBLIGATOIRE en production (≥ 16 caractères) : sans lui, deploy.sh refuse de
# déployer et le Dockerfile échoue — c'est volontaire (fail-closed).
# Généré sur le VPS par : python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
# Ne jamais commiter ce fichier (.env est gitignoré).
# Non défini (dev local) = accès libre. Voir README.md §"Accès protégé".
SHEET_PASSWORD=

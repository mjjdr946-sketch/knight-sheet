# Copier en .env (chmod 600) sur le VPS. Aucun secret ici : app sans auth,
# sans backend, sans donnée serveur.
KNIGHT_PORT=8011
KNIGHT_BIND_IP=127.0.0.1
KNIGHT_DOMAIN=knight-nunnun.duckdns.org
# host = Caddy système du VPS (défaut, modèle Biblio en production)
# bundled = conteneur Caddy de cette stack (ports 8080/8443 par défaut)
KNIGHT_TLS_MODE=host
KNIGHT_CADDY_HTTP=8080
KNIGHT_CADDY_HTTPS=8443
# page de contrôle du deploiement (la racine fait un redirect vers /personnage/combat)
KNIGHT_CHECK_PATH=/personnage/combat
# Renseigné par deploy/deploy.sh (traçabilité image)
KNIGHT_GIT_SHA=dev